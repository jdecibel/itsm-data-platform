# Copy this file to .env before running `docker compose up` (never commit the real .env — it's gitignored repo-wide).
# All values below are local-dev-only placeholders — fine to leave as-is, no real secrets involved.

# Linux hosts: set this to your own UID (`id -u`) so files Airflow writes into ./dags, ./plugins,
# ./logs aren't owned by root on the host. macOS/Docker Desktop handles this automatically, but the
# variable still needs to exist or compose will warn.
AIRFLOW_UID=50000

# Airflow's own metadata DB (postgres-airflow) — internal only, not exposed to the host.
AIRFLOW_DB_USER=test
AIRFLOW_DB_PASSWORD=test
AIRFLOW_DB_NAME=airflow

# Warehouse stand-in (postgres-warehouse) — this is where the landing schema will live.
WAREHOUSE_DB_USER=test
WAREHOUSE_DB_PASSWORD=test
WAREHOUSE_DB_NAME=itsm_warehouse

# Airflow webserver admin login (http://localhost:8081)
AIRFLOW_ADMIN_USER=test
AIRFLOW_ADMIN_PASSWORD=test

# Read-only role (warehouse_readonly) — SELECT-only access to the raw schema,
# for any tool that should never be able to write. Enforced at the DB level
# via sql/readonly_role.sql, not just by convention.
WAREHOUSE_RO_PASSWORD=warehouse_ro
